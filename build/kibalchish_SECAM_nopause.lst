------- FILE kibalchish.asm
      3  0000 ????	       00 01	   NO_ILLEGAL_OPCODES =	1
------- FILE macro.h LEVEL 2 PASS 2
      0  0000 ????				      include	"macro.h"
      1  0000 ????						; MACRO.H
      2  0000 ????						; Version 1.11, 01/FEB/2026
      3  0000 ????
      4  0000 ????	       00 6f	   VERSION_MACRO =	111
      5  0000 ????
      6  0000 ????						;
      7  0000 ????						; THIS FILE IS EXPLICITLY SUPPORTED AS A DASM-PREFERRED COMPANION FILE
      8  0000 ????						; The latest version can be found at https://dasm-assembler.github.io/
      9  0000 ????						;
     10  0000 ????						; This file defines DASM macros useful for development for the Atari 2600.
     11  0000 ????						; It is distributed as a companion machine-specific support package
     12  0000 ????						; for the DASM compiler.
     13  0000 ????						;
     14  0000 ????						; Many thanks to the people who have contributed. If you find an issue with the
     15  0000 ????						; contents, or would like ot add something, please report as an issue at...
     16  0000 ????						; https://github.com/dasm-assembler/dasm/issues
     17  0000 ????
     18  0000 ????
     19  0000 ????						; Latest Revisions...
     20  0000 ????						; 1.11  01/FEB/2026	 - added macros ALIGN_PAGE, BYTE_COUNT, CHECK_PAGE, TIMER_SETUP
     21  0000 ????						;			   and TIMER_WAIT
     22  0000 ????						; 1.10  09/MAY/2022	 - ("nop 0") should be changed to "nop VSYNC", to ensure that
     23  0000 ????						;			   the instruction will access a "safe" memory location even
     24  0000 ????						;			   when a different TIA_BASE_ADDRESS is defined - ale_79
     25  0000 ????						; 1.09  05/SEP/2020	 - updated license/links
     26  0000 ????						; 1.08  13/JUL/2020	 - added use of LXA to CLEAN_START
     27  0000 ????						; 1.07  19/JAN/2020	 - correction to comment VERTICAL_SYNC
     28  0000 ????						; 1.06  03/SEP/2004	 - nice revision of VERTICAL_SYNC (Edwin Blink)
     29  0000 ????						; 1.05  14/NOV/2003	 - Added VERSION_MACRO equate (which will reflect 100x version #)
     30  0000 ????						;			   This will allow conditional code to verify MACRO.H being
     31  0000 ????						;			   used for code assembly.
     32  0000 ????						; 1.04  13/NOV/2003	 - SET_POINTER macro added (16-bit address load)
     33  0000 ????						;
     34  0000 ????						; 1.03  23/JUN/2003	 - CLEAN_START macro added - clears TIA, RAM, registers
     35  0000 ????						;
     36  0000 ????						; 1.02  14/JUN/2003	 - VERTICAL_SYNC macro added
     37  0000 ????						;			   (standardised macro for vertical synch code)
     38  0000 ????						; 1.01  22/MAR/2003	 - SLEEP macro added.
     39  0000 ????						;			 - NO_ILLEGAL_OPCODES switch implemented
     40  0000 ????						; 1.0	22/MAR/2003		Initial release
     41  0000 ????
     42  0000 ????						; Note: Some of these macros use illegal opcodes.  To disable illegal opcode usage,
     43  0000 ????						;   define the symbol NO_ILLEGAL_OPCODES (-DNO_ILLEGAL_OPCODES=1 on command-line).
     44  0000 ????						;   If you do not allow illegal opcode usage, you must include this file
     45  0000 ????						;   *after* including VCS.H (as the non-illegal opcodes access hardware
     46  0000 ????						;   registers and require them to be defined first).
     47  0000 ????
     48  0000 ????						; Available macros...
     49  0000 ????						;   SLEEP n		 - sleep for n cycles
     50  0000 ????						;   VERTICAL_SYNC	 - correct 3 scanline vertical synch code
     51  0000 ????						;   CLEAN_START	 - set machine to known state on startup
     52  0000 ????						;   SET_POINTER	 - load a 16-bit absolute to a 16-bit variable
     53  0000 ????						;   BOUNDARY byte#	 - pad to byte # in page and count free bytes
     54  0000 ????						;   ALIGN_PAGE 	 - align code to 256-byte page boundary and report free space
     55  0000 ????						;   BYTE_COUNT 	 - report number of bytes used by a section
     56  0000 ????						;   CHECK_PAGE 	 - verify code/data hasn't crossed a page boundary
     57  0000 ????						;   TIMER_SETUP n	 - setup a timer for n scanlines
     58  0000 ????						;   TIMER_WAIT 	 - wait for the timer to expire
     59  0000 ????
     60  0000 ????						;-------------------------------------------------------------------------------
     61  0000 ????						; SLEEP duration
     62  0000 ????						; Original author: Thomas Jentzsch
     63  0000 ????						; Inserts code which takes the specified number of cycles to execute.	This is
     64  0000 ????						; useful for code where precise timing is required.
     65  0000 ????						; ILLEGAL-OPCODE VERSION DOES NOT AFFECT FLAGS OR REGISTERS.
     66  0000 ????						; LEGAL OPCODE VERSION MAY AFFECT FLAGS
     67  0000 ????						; Uses illegal opcode (DASM 2.20.01 onwards).
     68  0000 ????
     69  0000 ????				      MAC	sleep
     70  0000 ????			   .CYCLES    SET	{1}
     71  0000 ????
     72  0000 ????				      IF	.CYCLES < 2
     73  0000 ????				      ECHO	"MACRO ERROR: 'SLEEP': Duration must be > 1"
     74  0000 ????				      ERR
     75  0000 ????				      ENDIF
     76  0000 ????
     77  0000 ????				      IF	.CYCLES & 1
     78  0000 ????				      IFNCONST	NO_ILLEGAL_OPCODES
     79  0000 ????				      nop	VSYNC
     80  0000 ????				      ELSE
     81  0000 ????				      bit	VSYNC
     82  0000 ????				      ENDIF
     83  0000 ????			   .CYCLES    SET	.CYCLES - 3
     84  0000 ????				      ENDIF
     85  0000 ????
     86  0000 ????				      REPEAT	.CYCLES / 2
     87  0000 ????				      nop
     88  0000 ????				      REPEND
     89  0000 ????				      ENDM		;usage: SLEEP n (n>1)
     90  0000 ????
     91  0000 ????						;-------------------------------------------------------------------------------
     92  0000 ????						; VERTICAL_SYNC
     93  0000 ????						; revised version by Edwin Blink -- saves bytes!
     94  0000 ????						; Inserts the code required for a proper 3 scanline vertical sync sequence
     95  0000 ????						; Note: Alters the accumulator
     96  0000 ????
     97  0000 ????						; OUT: A = 0
     98  0000 ????
     99  0000 ????				      MAC	vertical_sync
    100  0000 ????				      lda	#%1110	; each '1' bits generate a VSYNC ON line (bits 1..3)
    101  0000 ????			   .VSLP1     sta	WSYNC	; 1st '0' bit resets Vsync, 2nd '0' bit exit loop
    102  0000 ????				      sta	VSYNC
    103  0000 ????				      lsr
    104  0000 ????				      bne	.VSLP1	; branch until VSYNC has been reset
    105  0000 ????				      ENDM
    106  0000 ????
    107  0000 ????						;-------------------------------------------------------------------------------
    108  0000 ????						; CLEAN_START
    109  0000 ????						; Original author: Andrew Davie
    110  0000 ????						; Standardised start-up code, clears stack, all TIA registers and RAM to 0
    111  0000 ????						; Sets stack pointer to $FF, and all registers to 0
    112  0000 ????						; Sets decimal mode off, sets interrupt flag (kind of un-necessary)
    113  0000 ????						; Use as very first section of code on boot (ie: at reset)
    114  0000 ????						; Code written to minimise total ROM usage - uses weird 6502 knowledge :)
    115  0000 ????
    116  0000 ????				      MAC	clean_start
    117  0000 ????				      sei
    118  0000 ????				      cld
    119  0000 ????
    120  0000 ????				      IFNCONST	NO_ILLEGAL_OPCODES
    121  0000 ????				      lxa	#0
    122  0000 ????				      ELSE
    123  0000 ????				      ldx	#0
    124  0000 ????				      txa
    125  0000 ????				      ENDIF
    126  0000 ????				      tay
    127  0000 ????			   .CLEAR_STACK dex
    128  0000 ????				      txs
    129  0000 ????				      pha
    130  0000 ????				      bne	.CLEAR_STACK	; SP=$FF, X = A = Y = 0
    131  0000 ????
    132  0000 ????				      ENDM
    133  0000 ????
    134  0000 ????						;-------------------------------------------------------
    135  0000 ????						; SET_POINTER
    136  0000 ????						; Original author: Manuel Rotschkar
    137  0000 ????						;
    138  0000 ????						; Sets a 2 byte RAM pointer to an absolute address.
    139  0000 ????						;
    140  0000 ????						; Usage: SET_POINTER pointer, address
    141  0000 ????						; Example: SET_POINTER SpritePTR, SpriteData
    142  0000 ????						;
    143  0000 ????						; Note: Alters the accumulator, NZ flags
    144  0000 ????						; IN 1: 2 byte RAM location reserved for pointer
    145  0000 ????						; IN 2: absolute address
    146  0000 ????
    147  0000 ????				      MAC	set_pointer
    148  0000 ????			   .POINTER   SET	{1}
    149  0000 ????			   .ADDRESS   SET	{2}
    150  0000 ????
    151  0000 ????				      LDA	#<.ADDRESS	; Get Lowbyte of Address
    152  0000 ????				      STA	.POINTER	; Store in pointer
    153  0000 ????				      LDA	#>.ADDRESS	; Get Hibyte of Address
    154  0000 ????				      STA	.POINTER+1	; Store in pointer+1
    155  0000 ????
    156  0000 ????				      ENDM
    157  0000 ????
    158  0000 ????						;-------------------------------------------------------
    159  0000 ????						; BOUNDARY byte#
    160  0000 ????						; Original author: Denis Debro (borrowed from Bob Smith / Thomas)
    161  0000 ????						;
    162  0000 ????						; Push data to a certain position inside a page and keep count of how
    163  0000 ????						; many free bytes the programmer will have.
    164  0000 ????						;
    165  0000 ????						; eg: BOUNDARY 5    ; position at byte #5 in page
    166  0000 ????
    167  0000 ????			   .FREE_BYTES SET	0
    168  0000 ????				      MAC	boundary
    169  0000 ????				      REPEAT	256
    170  0000 ????				      IF	<. % {1} = 0
    171  0000 ????				      MEXIT
    172  0000 ????				      ELSE
    173  0000 ????			   .FREE_BYTES SET	.FREE_BYTES + 1
    174  0000 ????				      .byte	$00
    175  0000 ????				      ENDIF
    176  0000 ????				      REPEND
    177  0000 ????				      ENDM
    178  0000 ????
    179  0000 ????						;-------------------------------------------------------
    180  0000 ????						; ALIGN_PAGE
    181  0000 ????						; Aligns code to a 256-byte page boundary and reports free space.
    182  0000 ????						; Useful for ensuring data tables don't cross page boundaries, which
    183  0000 ????						; can cause timing issues on the 6502.
    184  0000 ????						;
    185  0000 ????						; Usage: ALIGN_PAGE description
    186  0000 ????						; Example: ALIGN_PAGE "Sprite Data"
    187  0000 ????						;
    188  0000 ????						; Note: Echoes the number of free bytes before the specified section
    189  0000 ????
    190  0000 ????				      MAC	align_page
    191  0000 ????			   .Align
    192  0000 ????				      align	256
    193  0000 ????				      ECHO	"###", [* - .Align]d, "bytes free before", {1}
    194  0000 ????				      ENDM
    195  0000 ????
    196  0000 ????						;-------------------------------------------------------
    197  0000 ????						; BYTE_COUNT
    198  0000 ????						; Reports the number of bytes used by a section of code or data.
    199  0000 ????						; Useful for tracking ROM usage and optimizing code size.
    200  0000 ????						;
    201  0000 ????						; Usage: BYTE_COUNT start_label, "description"
    202  0000 ????						; Example: BYTE_COUNT SpriteStart, "Sprite Graphics"
    203  0000 ????						;
    204  0000 ????						; IN 1: Label marking the start position
    205  0000 ????						; IN 2: Description string for the section
    206  0000 ????
    207  0000 ????				      MAC	byte_count
    208  0000 ????				      ECHO	">>>", {2}, ":", [* - {1}]d, "bytes"
    209  0000 ????				      ENDM
    210  0000 ????
    211  0000 ????						;-------------------------------------------------------
    212  0000 ????						; CHECK_PAGE
    213  0000 ????						; Verifies that code/data hasn't crossed a page boundary.
    214  0000 ????						; Generates an assembly error if the boundary was crossed.
    215  0000 ????						; Critical for 6502 code where page crossing can affect timing
    216  0000 ????						; or cause indirect addressing issues.
    217  0000 ????						;
    218  0000 ????						; Usage: CHECK_PAGE position, "description"
    219  0000 ????						; Example: CHECK_PAGE TableStart, "Jump Table"
    220  0000 ????						;
    221  0000 ????						; IN 1: Starting position to check against
    222  0000 ????						; IN 2: Description string for error message
    223  0000 ????
    224  0000 ????				      MAC	check_page
    225  0000 ????			   .PREV_POS  SET	. - 1
    226  0000 ????				      IF	>.PREV_POS != >{1}
    227  0000 ????				      ECHO	""
    228  0000 ????				      ECHO	"ERROR:", {2}, "crosses page"
    229  0000 ????				      ECHO	""
    230  0000 ????				      ERR
    231  0000 ????				      ENDIF
    232  0000 ????				      ENDM
    233  0000 ????
    234  0000 ????						;-------------------------------------------------------
    235  0000 ????						; Usage: TIMER_SETUP lines
    236  0000 ????						; where lines is the number of scanlines to skip (> 2).
    237  0000 ????						; The timer will be set so that it expires before this number
    238  0000 ????						; of scanlines. A WSYNC will be done first.
    239  0000 ????
    240  0000 ????				      MAC	timer_setup
    241  0000 ????			   .lines     SET	{1}
    242  0000 ????			   .cycles    SET	((.lines * 76) - 13)
    243  0000 ????						; special case for when we have two timer events in a line
    244  0000 ????						; and our 2nd event straddles the WSYNC boundary
    245  0000 ????				      if	(.cycles % 64) < 12
    246  0000 ????				      lda	#(.cycles / 64) - 1
    247  0000 ????				      sta	WSYNC
    248  0000 ????				      else
    249  0000 ????				      lda	#(.cycles / 64)
    250  0000 ????				      sta	WSYNC
    251  0000 ????				      endif
    252  0000 ????				      sta	TIM64T
    253  0000 ????				      ENDM
    254  0000 ????
    255  0000 ????						;-------------------------------------------------------
    256  0000 ????						; Use with TIMER_SETUP to wait for timer to complete.
    257  0000 ????						; Performs a WSYNC afterwards.
    258  0000 ????
    259  0000 ????				      MAC	timer_wait
    260  0000 ????			   .waittimer
    261  0000 ????				      lda	INTIM
    262  0000 ????				      bne	.waittimer
    263  0000 ????				      sta	WSYNC
    264  0000 ????				      ENDM
    265  0000 ????
